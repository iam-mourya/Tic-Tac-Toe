<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A0C15"
                android:endColor="#1C0D22"
                android:angle="45" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#3300F0FF"
                android:endColor="#3300FFA0"
                android:angle="135" />
        </shape>
    </item>
    <item android:top="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
        </shape>
    </item>
</layer-list>

